# ============================================================================
# LifeSync - variables de entorno
#
# Copiá este archivo a `.env` y completá los valores.
# NUNCA commitees el `.env` real: contiene secretos.
#
# Hoy la aplicación LEE los bloques "App", "Servidor", "Supabase" y "Cifrado".
# WhatsApp, Google OAuth y Gemini están documentados acá porque son las
# variables mínimas del Sprint 1 (ver docs/03-arquitectura-y-stack.md) y se
# van a ir cargando en su tarea.
#
# Sin las credenciales de Supabase la app arranca igual, en modo degradado:
# /health responde 200 y /health/ready responde 503. En ENVIRONMENT=production
# es al revés: sin ellas el arranque falla, para no desplegar sin cifrado.
#
# ---------------------------------------------------------------------------
# PRODUCCIÓN (PB-007)
#
# Con ENVIRONMENT=production son OBLIGATORIAS estas nueve:
#   SUPABASE_URL · SUPABASE_KEY · TOKEN_ENCRYPTION_KEY
#   WHATSAPP_TOKEN · WHATSAPP_PHONE_NUMBER_ID
#   WHATSAPP_VERIFY_TOKEN · WHATSAPP_APP_SECRET
#   GOOGLE_API_KEY  (PB-005)
#
# Una variable DEFINIDA PERO VACÍA cuenta como ausente: `WHATSAPP_APP_SECRET=`
# hace fallar el arranque igual que no ponerla. Es a propósito — si pasara como
# configurada, el webhook validaría las firmas contra un secreto vacío.
#
# El validador corta en el primer grupo que falla, así que cargalas TODAS de
# una sola vez o vas a necesitar cuatro deploys para descubrir las cuatro.
# Ver la sección "Despliegue" del README.
# ============================================================================

# --- App --------------------------------------------------------------------
# development | staging | production | testing
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = logs JSON (staging/producción) | false = consola coloreada (dev)
# Si se omite, se deduce del ENVIRONMENT.
LOG_JSON=false

# --- Servidor ---------------------------------------------------------------
HOST=0.0.0.0
# En producción NO definas PORT: la plataforma lo inyecta y hay que respetarlo.
PORT=8000
# Autorecarga de uvicorn: sólo en desarrollo. En producción el código la ignora
# aunque llegue en true, pero mejor no definirla.
RELOAD=true

# --- Supabase (PB-003) ------------------------------------------------------
# Dashboard de Supabase → Project Settings → API.
SUPABASE_URL=
# IMPORTANTE: va la *service_role* key, NO la anon key. El backend escribe
# tokens de todos los usuarios y necesita saltear RLS. Nunca la expongas en un
# cliente ni la commitees: es equivalente a la contraseña de la base.
SUPABASE_KEY=
# Sólo se usa para verificar JWTs de Supabase Auth. Hoy se lee pero no se usa;
# entra en juego con los endpoints de autenticación (PB-009).
SUPABASE_JWT_SECRET=

# --- Cifrado de credenciales en reposo (PB-003 · RF-18) ---------------------
# Clave Fernet: 32 bytes en base64 urlsafe. Generar con
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde, TODOS los tokens guardados quedan ilegibles y cada usuario
# tiene que volver a conectar sus cuentas.
TOKEN_ENCRYPTION_KEY=

# --- WhatsApp Cloud API (PB-004) --------------------------------------------
# Dashboard de Meta → tu app → WhatsApp → API Setup.
#
# Token de acceso para llamar a la Graph API. El temporal del dashboard dura
# 24 h; para algo estable, generá uno de System User.
WHATSAPP_TOKEN=
# ID de NUESTRO número de negocio. Es lo que arma la URL de envío.
WHATSAPP_PHONE_NUMBER_ID=
# Lo inventás vos y lo pegás igual en el dashboard al configurar el webhook.
# Se usa SÓLO en el handshake GET. Conviene rotarlo una vez configurado: puede
# haber quedado en los logs de acceso del hosting.
WHATSAPP_VERIFY_TOKEN=
# App Secret de la aplicación (Settings → Basic). Es OTRA cosa distinta del
# verify token: con esto se valida la firma HMAC de cada POST entrante, que es
# lo único que impide que cualquiera inyecte mensajes falsos (RF-18).
# Sin esta variable, en desarrollo el webhook acepta POSTs sin firmar y lo
# avisa por log; en producción la app directamente no arranca.
WHATSAPP_APP_SECRET=

# --- Google OAuth2 (PB-009) -------------------------------------------------
# Credenciales de la app en Google Cloud Console → Credenciales → ID de cliente
# de OAuth 2.0, tipo "Aplicación web".
#
# NO son obligatorias en producción, a diferencia de las nueve de arriba: sin
# ellas la app arranca igual, todo lo demás funciona y /conectar avisa que la
# conexión con Google no está disponible. Es una integración, no el circuito
# central.
#
# Antes hay que habilitar la Google Calendar API en el proyecto y, en la
# pantalla de consentimiento, agregarte como usuario de prueba.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que ser IDÉNTICA a la registrada en Google, incluida la barra final:
# compara el string completo y cualquier diferencia devuelve
# `redirect_uri_mismatch`. En local:
#   http://localhost:8000/oauth/google/callback
GOOGLE_REDIRECT_URI=

# --- Gemini / agente conversacional (PB-005) --------------------------------
# Key de Google AI Studio (https://aistudio.google.com/apikey).
#
# OJO: tener la key no alcanza. La API "Generative Language" tiene que estar
# HABILITADA en el proyecto de Google Cloud al que pertenece, o cada llamada
# devuelve 403 PERMISSION_DENIED. Si pasa, el propio error trae el link de la
# consola para habilitarla.
#
# Sin esta variable la app arranca igual: los comandos fijos siguen andando y
# el lenguaje natural recibe un aviso honesto. En ENVIRONMENT=production, en
# cambio, el arranque falla: degradar en silencio en producción es peor.
GOOGLE_API_KEY=
# Modelo a usar. Opcional: si se omite, gemini-3.5-flash-lite.
#
# El `gemini-1.5-flash` del documento de arquitectura YA NO EXISTE, y
# `gemini-2.5-flash` aparece listado pero devuelve 404 a las cuentas nuevas.
#
# La cuota del plan gratuito es POR MODELO Y POR DÍA, y en los flash grandes
# es BRUTAL: tanto gemini-3.6-flash como gemini-3.5-flash dan 20 peticiones
# diarias (verificado agotándolas). Un turno con herramientas son 2-3
# llamadas, así que son ~7 turnos por día: se acaban ensayando.
#
# Si el bot dice "estoy al límite de consultas", la salida es cambiar acá de
# modelo: cada uno tiene cupo propio, y cambiar es empezar con el tanque
# lleno. La diaria resetea a medianoche de California, no "en un minuto".
#
#   gemini-3.5-flash-lite   ~0,7-2,1 s   (el default; cuota diaria más holgada)
#   gemini-3.5-flash        ~1,6-2,1 s   (mejor modelo, 20/día)
#   gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
